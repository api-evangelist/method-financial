            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.methodfi.com/accounts",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "page",
                "value": "",
