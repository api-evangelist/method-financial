{
  "opencollection": "1.0.0",
  "info": {
    "name": "Method Teams API",
    "version": "2026-03-30"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the current team",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.methodfi.com/teams",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the team hierarchy (the team associated with the current API key, plus any parent/child teams) as a list."
        },
        {
          "info": {
            "name": "Create a child team",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://production.methodfi.com/teams",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new child team under the current team."
        },
        {
          "info": {
            "name": "Set default encryption key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://production.methodfi.com/teams/default_encryption_key",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Sets the default encryption key for the team. Used for encrypting sensitive data in API responses."
        },
        {
          "info": {
            "name": "List MLE public keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.methodfi.com/teams/mle/public_keys",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns all Message-Level Encryption (MLE) public keys registered for the team."
        },
        {
          "info": {
            "name": "Create an MLE public key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://production.methodfi.com/teams/mle/public_keys",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Registers a new Message-Level Encryption (MLE) public key for the team."
        },
        {
          "info": {
            "name": "Retrieve an MLE public key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.methodfi.com/teams/mle/public_keys/:id",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the MLE public key."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a single MLE public key by its identifier."
        },
        {
          "info": {
            "name": "Delete an MLE public key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://production.methodfi.com/teams/mle/public_keys/:id",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the MLE public key."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes an MLE public key by its identifier. This action is irreversible."
        }
      ]
    }
  ],
  "bundled": true
}