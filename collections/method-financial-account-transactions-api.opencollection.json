{
  "opencollection": "1.0.0",
  "info": {
    "name": "Method Account Transactions API",
    "version": "2026-03-30"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all account transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.methodfi.com/accounts/:accountId/transactions",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the account."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination (1-indexed)."
              },
              {
                "name": "page_limit",
                "value": "",
                "type": "query",
                "description": "Number of items per page."
              },
              {
                "name": "page_cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for cursor-based pagination. Use the value from `Pagination-Page-Cursor-Next` or `Pagination-Page-Cursor-Prev` response headers."
              },
              {
                "name": "from_date",
                "value": "",
                "type": "query",
                "description": "Filter results from this date (inclusive, YYYY-MM-DD format)."
              },
              {
                "name": "to_date",
                "value": "",
                "type": "query",
                "description": "Filter results to this date (inclusive, YYYY-MM-DD format)."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a paginated list of transactions for the specified account. Results can be filtered by status and date range."
        },
        {
          "info": {
            "name": "Retrieve an account transaction",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.methodfi.com/accounts/:accountId/transactions/:accTxnId",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the account."
              },
              {
                "name": "accTxnId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the account transaction."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves an account transaction by its unique identifier."
        }
      ]
    }
  ],
  "bundled": true
}