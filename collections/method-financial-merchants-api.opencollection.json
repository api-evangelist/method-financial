{
  "opencollection": "1.0.0",
  "info": {
    "name": "Method Merchants API",
    "version": "2026-03-30"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Merchants",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all merchants",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.methodfi.com/merchants",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Search merchants by name."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter merchants by account type."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of merchants from the Method merchant directory."
        },
        {
          "info": {
            "name": "Retrieve a merchant",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.methodfi.com/merchants/:mchId",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "mchId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the merchant."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a single merchant by its identifier."
        }
      ]
    }
  ],
  "bundled": true
}