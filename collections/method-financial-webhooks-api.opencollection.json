{
  "opencollection": "1.0.0",
  "info": {
    "name": "Method Webhooks API",
    "version": "2026-03-30"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.methodfi.com/webhooks",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns all active and requires-attention webhooks for the authenticated team."
        },
        {
          "info": {
            "name": "Create a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://production.methodfi.com/webhooks",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new webhook subscription for the specified event type."
        },
        {
          "info": {
            "name": "Retrieve a webhook",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.methodfi.com/webhooks/:webhookId",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the webhook."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a single webhook by its identifier."
        },
        {
          "info": {
            "name": "Update a webhook status",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://production.methodfi.com/webhooks/:webhookId",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the webhook."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates an existing webhook's status."
        },
        {
          "info": {
            "name": "Delete a webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://production.methodfi.com/webhooks/:webhookId",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the webhook."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes a webhook subscription."
        }
      ]
    }
  ],
  "bundled": true
}