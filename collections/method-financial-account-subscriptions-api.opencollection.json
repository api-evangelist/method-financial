            "method": "GET",
            "url": "https://production.methodfi.com/accounts/:accountId/subscriptions",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the account."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of subscriptions for the specified account."
        },
        {
          "info": {
