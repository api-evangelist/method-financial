            "url": "https://production.methodfi.com/accounts/:accountId/subscriptions/:subId",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the account."
              },
              {
                "name": "subId",
                "value": "",
