            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the account."
              },
              {
                "name": "subId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the account subscription."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
