{
  "opencollection": "1.0.0",
  "info": {
    "name": "Method Entity Identities API",
    "version": "2026-03-30"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Entity Identities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all entity identities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.methodfi.com/entities/:entityId/identities",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the entity."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination (1-indexed)."
              },
              {
                "name": "page_limit",
                "value": "",
                "type": "query",
                "description": "Number of items per page."
              },
              {
                "name": "page_cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for cursor-based pagination. Use the value from `Pagination-Page-Cursor-Next` or `Pagination-Page-Cursor-Prev` response headers."
              },
              {
                "name": "from_date",
                "value": "",
                "type": "query",
                "description": "Filter results from this date (inclusive, YYYY-MM-DD format)."
              },
              {
                "name": "to_date",
                "value": "",
                "type": "query",
                "description": "Filter results to this date (inclusive, YYYY-MM-DD format)."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of identity records for the specified entity."
        },
        {
          "info": {
            "name": "Create an entity identity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://production.methodfi.com/entities/:entityId/identities",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the entity."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new identity retrieval for the specified entity."
        },
        {
          "info": {
            "name": "Retrieve an entity identity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.methodfi.com/entities/:entityId/identities/:idnId",
            "headers": [
              {
                "name": "Method-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the entity."
              },
              {
                "name": "idnId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the entity identity."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a single entity identity record by its identifier."
        }
      ]
    }
  ],
  "bundled": true
}